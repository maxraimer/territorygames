# Copy to .env.local (git-ignored by Vite's default .gitignore) and fill in
# with your Firebase project's values to enable src/api/adapters/
# firebaseLobbyAdapter.js and firebaseGameSyncAdapter.js. Until these are
# set, and until lobbyApi.js/gameSyncApi.js are switched to import the
# firebase adapters instead of the mock ones, the app runs entirely on the
# mock (localStorage-backed, same-browser-only) adapters — nothing here is
# required for local dev.
#
# Where to find these values: Firebase console -> Project settings ->
# General -> "Your apps" -> Web app -> SDK setup and configuration -> Config.
# Realtime Database (not Firestore) must be enabled for this project, since
# the adapters use its ref()/onValue()/runTransaction() API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
